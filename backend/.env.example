# MARSCOPE Backend Environment Variables

# App
APP_NAME=MARSCOPE Backend
APP_VERSION=0.2.0
DEBUG=false

# MOLA DEM
MOLA_COG_PATH=/data/Mars_MGS_MOLA_DEM_mosaic_global_463m_cog.tif

# NASA API (get free key at https://api.nasa.gov/)
NASA_API_KEY=your_nasa_api_key_here

# External APIs
PDS_BASE_URL=https://pds-geosciences.wustl.edu
USGS_BASE_URL=https://planetarymaps.usgs.gov
IAU_BASE_URL=https://planetarynames.wr.usgs.gov

# Climate APIs
MARS_WEATHER_BASE_URL=https://api.nasa.gov

# Rate limiting
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_MAX_RETRIES=3
EXTERNAL_API_BACKOFF_FACTOR=0.5

# Caching
CACHE_TTL_SECONDS=3600
TILE_CACHE_TTL_SECONDS=86400

# CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]